# Pinned runtime the seed bootstraps. Single source of truth: the bootstrap, the
# environment, and CI all read this, so bumping a version is one edit here.
#
# Both digests are the published release artifacts and are verified before use --
# a seed that silently accepted a different Ghidra would be worse than no seed.

GHIDRA_VERSION=12.2
GHIDRA_DIRNAME=ghidra_12.2_PUBLIC
GHIDRA_ARCHIVE=ghidra_12.2_PUBLIC_20261016.zip
GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.2_build/ghidra_12.2_PUBLIC_20261016.zip
GHIDRA_SHA256=2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67

# Ghidra 12.2 requires JDK 25 (application.java.min=25) and refuses to start on an older JDK.
JDK_VERSION=25.0.5+8
JDK_DIRNAME=jdk-25.0.5+8

# The JDK is the only arch-specific download here -- Ghidra itself is portable Java.
# bootstrap-runtime.sh selects one of these by `uname -m`; the unsuffixed JDK_ARCHIVE /
# JDK_URL / JDK_SHA256 it exports are derived, not set here, so nothing consumes a
# hard-coded x64 archive on an arm64 host.
JDK_ARCHIVE_X64=OpenJDK25U-jdk_x64_linux_hotspot_25.0.5_8.tar.gz
JDK_URL_X64=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5%2B8/OpenJDK25U-jdk_x64_linux_hotspot_25.0.5_8.tar.gz
JDK_SHA256_X64=68982529869257d0ee6b824ec5aa270ff8b118bb438670da0b97ebdab178d7fb

JDK_ARCHIVE_AARCH64=OpenJDK25U-jdk_aarch64_linux_hotspot_25.0.5_8.tar.gz
JDK_URL_AARCH64=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5%2B8/OpenJDK25U-jdk_aarch64_linux_hotspot_25.0.5_8.tar.gz
JDK_SHA256_AARCH64=bb5b2ded252f21c6090cf780b0a408ad0d83bbb557e702955643557f13231880
